# Set these in your shell; the CLI does not automatically load .env files.
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=your-model-name
AGENT_API_KEY=your-api-key
AGENT_RESPONSE_FORMAT=json_object
# Compatible local server example:
# AGENT_BASE_URL=http://127.0.0.1:8000/v1
# AGENT_MODEL=your-local-model-name
# AGENT_API_KEY=EMPTY
